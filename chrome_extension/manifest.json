{
  "manifest_version": 3,
  "name": "Supertonic Voice - Text to Speech",
  "version": "1.0.0",
  "description": "Right-click any text to convert it to voice using Supertonic TTS",
  "permissions": ["contextMenus"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
